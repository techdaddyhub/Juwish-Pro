<Window x:Class="JuwishPro.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JuwishPro"
        Height="840" Width="1300"
        MinHeight="640" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E11"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/app.ico">
    <Grid Background="#0B0E11">
        <wv2:WebView2 Name="webView"
                      DefaultBackgroundColor="#0B0E11"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
        
        <!-- Offline / Loading overlay if network or runtime fails -->
        <Border Name="errorPanel" Background="#0B0E11" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <Image Source="app.ico" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,24" />
                <TextBlock Name="txtErrorTitle" Text="Connection Offline" Foreground="#EAECEF" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Name="txtErrorMessage" Text="Network connection is currently unavailable. Please check your internet settings." Foreground="#848E9C" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,24" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Name="btnAction" Content="Retry Connection" Click="OnActionButtonClick" Background="#F0B90B" Foreground="#0B0E11" FontWeight="Bold" Padding="32,12" FontSize="14" HorizontalAlignment="Center" Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
