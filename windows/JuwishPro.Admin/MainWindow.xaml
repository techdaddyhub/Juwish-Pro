<Window x:Class="JuwishPro.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JuwishPro Admin | Mission Control"
        Height="840" Width="1300"
        MinHeight="640" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E11"
        Icon="app.ico">
    <Grid Background="#0B0E11">
        <wv2:WebView2 Name="webView"
                      DefaultBackgroundColor="#0B0E11"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
        
        <!-- Offline / Loading overlay if network fails -->
        <Border Name="errorPanel" Background="#0B0E11" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Connection Lost" Foreground="#EAECEF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="Unable to connect to JuwishPro Admin console." Foreground="#848E9C" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,20" />
                <Button Content="Retry Connection" Click="OnRetryClick" Background="#F0B90B" Foreground="#0B0E11" FontWeight="Bold" Padding="20,10" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
